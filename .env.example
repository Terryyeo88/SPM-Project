# Supabase connection settings
# Get the real values from: Supabase Dashboard -> Project Settings -> API (and -> Database)
# Copy this file to `.env`, fill in the real values, and NEVER commit `.env` itself.

# --- Frontend (Vue) ---
# Safe to expose in the browser — the anon key only works within Row Level Security policies.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Backend (Flask) ---
# Same URL, but the service role key is SECRET — it bypasses RLS entirely.
# Only ever read this from the backend server, never send it to the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct Postgres connection string (Project Settings -> Database -> Connection string).
# Only needed if Flask talks to Postgres directly (e.g. via SQLAlchemy) instead of
# going through the Supabase client library.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
