# Frontend Supabase settings -- PUBLISHABLE key only, never the secret one.
# Get these from: Supabase Dashboard -> Project Settings -> API Keys
# Copy this file to `.env` in this folder and fill in real values.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# The Flask backend, running locally via `flask --app wsgi run`.
VITE_API_BASE_URL=http://127.0.0.1:5000
