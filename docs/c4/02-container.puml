@startuml 02-container
' C4 Level 2 -- Containers inside ConnectSphere.
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()

title Container diagram for ConnectSphere

Person(staff, "Staff users", "Event Organizer, Event Coordinator, Coordinator Lead, Venue Staff, Technical Support Staff, Safety Officer")
Person(attendee, "Attendee", "Registers for events")

System_Boundary(cs, "ConnectSphere") {
    Container(spa, "Web Application", "Vue 3, Vite, Pinia, Vue Router", "Single-page app served to the browser. Role-based dashboards and views for events, clarification threads, venues, bookings, equipment, safety reviews and registrations; shows in-app notifications. Holds only the Supabase anon (publishable) key.")
    Container(api, "API Application", "Python 3, Flask, flask-cors, PyJWT", "JSON REST API. Verifies JWTs, enforces idle timeout and role/relationship authorisation, owns all business rules: event status state machine, coordinator assignment, clarifications, change requests, venue and equipment reservations, safety reviews, registration and in-app notifications.")
    ContainerDb(db, "Database", "PostgreSQL (Supabase)", "Events and audit logs, clarifications, change requests, coordinator assignments, safety reviews; venues, room layouts, bookings (no-overlap exclusion constraint), blocks; equipment types, units, requests and reservations; profiles, roles, sessions, registrations, notifications. RPC functions: register_attendee, delete_venue.")
}

System_Ext(supabaseAuth, "Supabase Auth", "Hosted identity provider; issues ES256 JWTs and publishes a JWKS endpoint.")

Rel(staff, spa, "Uses", "HTTPS, browser")
Rel(attendee, spa, "Uses", "HTTPS, browser")

Rel(spa, supabaseAuth, "Signs in with email/password, signs out, refreshes session", "supabase-js, HTTPS")
Rel(spa, api, "Calls with Authorization: Bearer <access token>", "JSON/HTTPS")

Rel(api, supabaseAuth, "Fetches and caches JWKS to verify token signatures", "HTTPS")
Rel(api, db, "Reads, writes and calls RPC functions using the service role key", "supabase-py / PostgREST, HTTPS")

SHOW_LEGEND()
@enduml
