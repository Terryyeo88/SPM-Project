# Settings for the Playwright e2e tests (frontend/e2e/). Copy this file to
# `.env.e2e` (gitignored) at the repo root and fill it in from:
#
#     npx supabase status -o env
#
# These MUST point at a local Supabase (npx supabase start). The tests
# refuse to run against anything else -- see frontend/e2e/support/env.js.
# Your normal .env / frontend/.env stay pointed at the shared project for
# manual testing; .env.e2e overrides them only while the tests run.

# Exactly http://127.0.0.1:54321 (API_URL): the backend checks each token's
# issuer against this, and local auth issues them for 127.0.0.1.
SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321

# SECRET_KEY (sb_secret_...) from `supabase status -o env` (backend only).
# Not the legacy SERVICE_ROLE_KEY JWT: local PostgREST can't verify that one
# once a signing key is configured, and the shared project uses the new
# sb_ keys too.
SUPABASE_SERVICE_ROLE_KEY=paste-SECRET_KEY-here

# PUBLISHABLE_KEY (sb_publishable_...) from `supabase status -o env`
# (browser + test setup), not the legacy ANON_KEY.
VITE_SUPABASE_ANON_KEY=paste-PUBLISHABLE_KEY-here

# Optional: the port Playwright starts the backend on (default 5000).
# E2E_BACKEND_PORT=5001
